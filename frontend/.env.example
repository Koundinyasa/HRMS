# Copy this file to .env and adjust. Never put secrets in a VITE_ variable:
# everything with this prefix is visible to anyone who opens the website.

# Address of the backend API (no trailing slash).
VITE_API_URL=http://localhost:3001/api

# Minutes without activity before a signed-in user is signed out.
# Optional; the default is 5.
VITE_IDLE_TIMEOUT_MINUTES=5

# Seconds between "this login is still open" signals (also how fast a replaced
# login notices it). Optional; default 5, allowed 2 to 60.
VITE_HEARTBEAT_SECONDS=5
