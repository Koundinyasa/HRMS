NODE_ENV=development
PORT=3001
# Allowed browser origin(s) for CORS. Several can be separated by commas.
# REQUIRED when NODE_ENV=production.
FRONTEND_URL=http://localhost:5173
# Swagger UI is always on in development. In production it is off unless true
# (and then only logged-in admins can open it).
SWAGGER_ENABLED=false
# How many reverse proxies / load balancers sit in front of the app (0 = none).
# Set to 1 behind a single proxy so rate limits use the real client IP.
TRUST_PROXY=0
# ── SQL Server (mssql) ────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_ENCRYPT=
DB_TRUST_SERVER_CERT=
# Optional connection pool and timeouts (these are the defaults). Each of the
# two database connections (main and chatbot) gets its own pool of this size.
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# DB_CONNECTION_TIMEOUT_MS=15000
# DB_REQUEST_TIMEOUT_MS=15000


JWT_SECRET=replace_with_64_char_random_hex_string

# ── Login sessions ───────────────────────────────────────────────────────────
# Lifetime of the access token: 30s, 15m, 24h, 7d (a bare number = seconds).
# Short on purpose: the browser renews it quietly through /auth/refresh.
ACCESS_TOKEN_TTL=15m
# A login ends after this many minutes without a refresh, and never lasts
# longer than the absolute limit.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_MINUTES=1440
# How long (seconds) the server remembers that a session is still active.
# On a second server instance a logout takes effect within this time.
SESSION_CACHE_SECONDS=30
# One login at a time per employee: replace (new sign-in ends the old one), block, or off.
SINGLE_SESSION_MODE=replace
# Used by block mode only: another login counts as in use if seen within this many seconds.
SESSION_ACTIVE_WINDOW_SECONDS=120
# Old session rows are deleted by the backend (SQL Server Express has no SQL
# Agent). Rows ended or expired more than RETENTION days ago are removed.
SESSION_PURGE_ENABLED=true
SESSION_PURGE_INTERVAL_HOURS=24
SESSION_PURGE_RETENTION_DAYS=30
# "Secure" cookie flag (needs HTTPS). Default: on when NODE_ENV=production.
# Set false only if production is served over plain HTTP.
COOKIE_SECURE=
# Accept tokens issued before sessions existed (no session id). Keep false;
# set true only for a short rollout window while old logins still exist.
ALLOW_LEGACY_TOKENS=false
# Development only: return the captcha answer with the captcha (for scripts).
# The backend refuses to start with this set to true in production.
CAPTCHA_DEBUG_ANSWER=false


EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password


CAPTCHA_TTL_MINUTES=